---
interface Props {
  /** Main title line (job title, degree, paper title). */
  title: string;
  /** Secondary line (institution, company, journal). */
  subtitle?: string;
  /** Location string — shown below the date badge. */
  location?: string;
  /** Date range or single date string (already formatted). */
  dates?: string;
  /** Bullet points. */
  highlights?: string[];
  /** URL to make the title a link. */
  url?: string;
  /** Render the subtitle in muted text rather than the accent color (e.g. author lists). */
  mutedSubtitle?: boolean;
}

const { title, subtitle, location, dates, highlights = [], url, mutedSubtitle = false } = Astro.props;
---

<li class="list-group-item cv-entry">
  <div class="cv-entry-grid">
    <div class="cv-entry-meta">
      {dates && <span class="badge-date">{dates}</span>}
      {location && <span class="cv-entry-location">{location}</span>}
    </div>
    <div class="cv-entry-body">
      {
        url ? (
          <h6 class="title">
            <a href={url} target="_blank" rel="noopener noreferrer">
              {title}
            </a>
          </h6>
        ) : (
          <h6 class="title">{title}</h6>
        )
      }
      {subtitle && <div class:list={['cv-entry-subtitle', { muted: mutedSubtitle }]}>{subtitle}</div>}
      {
        highlights.length > 0 && (
          <ul class="items">
            {highlights.map((h) => (
              <li>
                <span class="item" set:html={h} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</li>
