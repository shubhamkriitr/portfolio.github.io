---
interface Props {
  /** Main title line (job title, degree, paper title). */
  title: string;
  /** Secondary line (institution, company, journal, authors). */
  subtitle?: string;
  /** Location string — appended to the secondary line. */
  location?: string;
  /** Date range or single date string (already formatted). */
  dates?: string;
  /** Bullet points (may contain HTML). */
  highlights?: string[];
  /** URL to make the title a link. */
  url?: string;
}

const { title, subtitle, location, dates, highlights = [], url } = Astro.props;
const sub = [subtitle, location].filter(Boolean).join(' · ');
---

<li class="folio-entry">
  <div class="folio-entry-head">
    {
      url ? (
        <a class="folio-entry-title" href={url} target="_blank" rel="noopener noreferrer">
          {title}
        </a>
      ) : (
        <span class="folio-entry-title">{title}</span>
      )
    }
    {dates && <span class="folio-date">{dates}</span>}
  </div>
  {sub && <span class="folio-entry-sub">{sub}</span>}
  {
    highlights.length > 0 && (
      <ul class="folio-bullets">
        {highlights.map((h) => (
          <li>
            <span set:html={h} />
          </li>
        ))}
      </ul>
    )
  }
</li>
