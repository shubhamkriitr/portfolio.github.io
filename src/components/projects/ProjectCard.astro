---
import { site } from '@config/site';
import { withBase } from '@utils/base';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const href = project.data.redirect ?? project.data.url ?? `${site.base}/projects/${project.id}/`;
const isExternal = !!project.data.redirect;
const hasImg = !!project.data.img;
---

<li class="folio-entry">
  <div
    class:list={['proj', hasImg && 'folio-media']}
    data-href={href}
    data-external={isExternal ? 'true' : undefined}
    role="link"
    tabindex="0"
  >
    {
      project.data.img && (
        <img
          src={withBase(project.data.img)}
          alt={project.data.img_alt ?? project.data.title}
          loading="lazy"
          width="132"
          height="99"
          class="folio-media-thumb"
        />
      )
    }
    <div class="proj-body">
      <a
        href={href}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
        class="folio-work-title proj-link"
      >
        {project.data.title}
      </a>
      {project.data.description && <p class="folio-work-desc">{project.data.description}</p>}
      {
        project.data.github && (
          <div class="folio-actions">
            <a
              class="folio-action"
              href={`https://github.com/${project.data.github}`}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.data.title} on GitHub`}
            >
              GitHub
              {project.data.github_stars && (
                <span class="stars">
                  &nbsp;&middot;&nbsp;<span data-github-stars={project.data.github_stars} />&#9733;
                </span>
              )}
            </a>
          </div>
        )
      }
    </div>
  </div>
</li>

<style>
  .proj {
    cursor: pointer;
  }

  .proj-body {
    min-width: 0;
  }

  /* Title is a real <a>; the surrounding row is click-delegated in the page
     script so we never nest anchors. */
  .proj-link {
    text-decoration: none;
  }

  .proj:hover .proj-link {
    color: var(--global-theme-color);
  }

  .proj:focus-visible {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 4px;
  }

  .stars {
    font-variant-numeric: tabular-nums;
  }
</style>
