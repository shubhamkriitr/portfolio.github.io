---
import { site } from '@config/site';

const year = new Date().getFullYear();
const lastUpdated = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const isSticky = site.footer.position === 'sticky';
const footerStyle = isSticky
  ? 'position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; background-color: var(--global-bg-color);'
  : 'margin-top: auto;';
---

<footer class="site-footer" style={footerStyle}>
  <div class="footer-inner">
    <p>
      &copy; {year}
      {site.author.name}.
      {site.footer.text && <span set:html={site.footer.text} />}
      {site.footer.lastUpdated && <span>Last updated: {lastUpdated}.</span>}
    </p>
    {
      site.footer.impressum && (
        <p class="legal">
          <a href={site.footer.impressum}>Legal Notice</a>
        </p>
      )
    }
  </div>
</footer>

<style>
  /* Footer sits on the page ground — a hairline separates it, not a slab. */
  .site-footer {
    color: var(--global-footer-text-color);
    border-top: 1px solid var(--global-divider-color);
  }

  .footer-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem 2.5rem;
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .footer-inner p {
    margin: 0;
  }

  .legal {
    margin-top: 0.4rem;
  }

  .site-footer a {
    color: var(--global-footer-link-color);
    text-decoration: none;
    border-bottom: 1px solid var(--global-divider-color);
    transition: border-color 0.15s ease;
  }

  .site-footer a:hover {
    border-bottom-color: var(--global-theme-color);
    color: var(--global-theme-color);
  }
</style>
