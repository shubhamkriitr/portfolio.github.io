---
import { site } from '@config/site';

interface Props {
  date: Date | string;
  tags?: string[];
  categories?: string[];
  readingTime?: number;
}

const { date, tags = [], categories = [], readingTime } = Astro.props;

const d = date instanceof Date ? date : new Date(date);
const formattedDate = d.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = d.toISOString();
---

<div class="post-meta">
  <time datetime={isoDate}>{formattedDate}</time>

  {readingTime && <span class="sep" aria-hidden="true">/</span>}
  {readingTime && <span>{readingTime} min read</span>}

  {
    categories.map((cat) => (
      <>
        <span class="sep" aria-hidden="true">
          /
        </span>
        <a href={`${site.base}/blog/category/${cat}/`}>{cat}</a>
      </>
    ))
  }

  {
    tags.map((tag) => (
      <>
        <span class="sep" aria-hidden="true">
          /
        </span>
        <a href={`${site.base}/blog/tag/${tag}/`}>#{tag}</a>
      </>
    ))
  }
</div>

<style>
  /* Metadata is data: mono, muted, hairline separators — never coloured pills. */
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--global-text-color-light);
  }

  .sep {
    opacity: 0.45;
  }

  .post-meta a {
    color: var(--global-text-color-light);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .post-meta a:hover {
    color: var(--global-theme-color);
    border-bottom-color: var(--global-theme-color);
  }
</style>
