---
import { site } from '@config/site';
import { withBase } from '@utils/base';
import { readingTime } from '@utils/reading-time';
import type { CollectionEntry } from 'astro:content';

/** A local post from the 'posts' collection. */
type LocalPost = CollectionEntry<'posts'>;

/** A synthetic external post object (constructed in blog listing pages). */
interface ExternalPost {
  external: true;
  id: string;
  url: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    tags: string[];
    categories: string[];
    image?: string;
  };
  body?: undefined;
}

type PostEntry = LocalPost | ExternalPost;

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;

const isExternal = 'external' in post && post.external === true;

const title = post.data.title;
const description = post.data.description;
const tags = post.data.tags ?? [];
const categories = post.data.categories ?? [];
// Use `image` field as thumbnail (matches schema field name)
const thumbnail = (post.data as { image?: string }).image;
const thumbnailSrc = thumbnail ? withBase(thumbnail) : undefined;

const href = isExternal ? (post as ExternalPost).url : `${site.base}/blog/${post.id}/`;

const minutes =
  !isExternal && (post as LocalPost).body ? readingTime((post as LocalPost).body!) : undefined;

const d = post.data.date instanceof Date ? post.data.date : new Date(post.data.date);
const formattedDate = d.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const externalAttrs = isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<div class:list={['postrow', thumbnail && 'folio-media']}>
  {
    thumbnailSrc && (
      <img
        class="folio-media-thumb"
        src={thumbnailSrc}
        alt=""
        loading="lazy"
        width="132"
        height="99"
      />
    )
  }
  <div class="postrow-body">
    <div class="folio-entry-head">
      <a class="folio-entry-title" href={href} {...externalAttrs}>
        {title}
        {isExternal && <span class="ext" aria-hidden="true">&#x2197;</span>}
      </a>
      <time class="folio-date" datetime={d.toISOString()}>{formattedDate}</time>
    </div>

    {description && <p class="folio-work-desc">{description}</p>}

    <div class="folio-actions">
      {minutes && <span class="folio-action meta-static">{minutes} min</span>}
      {
        tags.map((tag) => (
          <a class="folio-action" href={`${site.base}/blog/tag/${tag}/`}>
            #{tag}
          </a>
        ))
      }
      {
        categories.map((cat) => (
          <a class="folio-action" href={`${site.base}/blog/category/${cat}/`}>
            {cat}
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .postrow-body {
    min-width: 0;
  }

  .ext {
    font-size: 0.7em;
    opacity: 0.6;
    margin-left: 0.25em;
  }

  /* Reading time is information, not a control — no hover affordance. */
  .meta-static {
    cursor: default;
  }

  .meta-static:hover {
    color: var(--global-text-color-light);
    border-bottom-color: transparent;
  }
</style>
