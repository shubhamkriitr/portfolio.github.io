---
import CVEntry from '@components/cv/CVEntry.astro';
import CVSection from '@components/cv/CVSection.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { withBase } from '@utils/base';
import type { JSONResume, RenderCV, RenderCVEntry } from '@utils/cv';
import { formatCVDate, formatDateRange } from '@utils/cv';
import yaml from 'js-yaml';

import cvRaw from '../data/cv.yml?raw';
import resumeData from '../data/resume.json';

const format = site.cv.format;

const renderCV = format === 'rendercv' ? (yaml.load(cvRaw) as RenderCV) : null;
const jsonResume = format === 'jsonresume' ? (resumeData as JSONResume) : null;

const rc = renderCV?.cv ?? null;
const education = (rc?.sections?.education ?? []) as RenderCVEntry[];
const experience = (rc?.sections?.experience ?? []) as RenderCVEntry[];
const rcPublications = (rc?.sections?.publications ?? []) as RenderCVEntry[];
const awards = (rc?.sections?.awards ?? []) as RenderCVEntry[];
const skills = (rc?.sections?.skills ?? []) as RenderCVEntry[];
const interests = (rc?.sections?.interests ?? []) as RenderCVEntry[];

const jr = jsonResume ?? null;
const jrLabel = jr?.basics?.label ?? '';
---

<Page title="CV" description={`Curriculum vitae of ${site.author.name}`}>
  <div class="folio">
    <header class="folio-pagehead">
      <h1 class="post-title">Curriculum&nbsp;Vitae</h1>
      {site.cv.pdfPath && (
        <a
          class="folio-more"
          href={withBase(site.cv.pdfPath)}
          target="_blank"
          rel="noopener noreferrer"
        >
          Download PDF &darr;
        </a>
      )}
    </header>

    <!-- ── RENDERCV ──────────────────────────────────────────────── -->
    {format === 'rendercv' && rc && (
      <>
        {(rc.email || rc.website || rc.location) && (
          <section class="folio-row" id="contact">
            <p class="folio-label">Contact</p>
            <div class="folio-body">
              <dl class="cv-contact">
                {rc.email && (
                  <>
                    <dt>Email</dt>
                    <dd><a href={`mailto:${rc.email}`}>{rc.email}</a></dd>
                  </>
                )}
                {rc.location && (
                  <>
                    <dt>Location</dt>
                    <dd>{rc.location}</dd>
                  </>
                )}
                {rc.website && (
                  <>
                    <dt>Website</dt>
                    <dd>
                      <a href={rc.website} target="_blank" rel="noopener noreferrer">
                        {rc.website.replace(/^https?:\/\//, '')}
                      </a>
                    </dd>
                  </>
                )}
              </dl>
            </div>
          </section>
        )}

        {rc.summary && (
          <section class="folio-row" id="summary">
            <p class="folio-label">Summary</p>
            <div class="folio-body folio-prose"><p>{rc.summary}</p></div>
          </section>
        )}

        {education.length > 0 && (
          <CVSection title="Education" id="education">
            <ul class="folio-stack">
              {education.map((e) => (
                <CVEntry
                  title={[e.degree, e.area].filter(Boolean).join(' in ')}
                  subtitle={e.institution}
                  location={e.location}
                  dates={formatDateRange(e.start_date, e.end_date)}
                  highlights={e.highlights}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {experience.length > 0 && (
          <CVSection title="Experience" id="experience">
            <ul class="folio-stack">
              {experience.map((e) => (
                <CVEntry
                  title={e.position ?? ''}
                  subtitle={e.company}
                  location={e.location}
                  dates={formatDateRange(e.start_date, e.end_date)}
                  highlights={e.highlights}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {rcPublications.length > 0 && (
          <CVSection title="Publications" id="publications">
            <ul class="folio-stack">
              {rcPublications.map((e) => (
                <CVEntry
                  title={e.title ?? ''}
                  subtitle={[e.authors?.join(', '), e.journal].filter(Boolean).join(' — ')}
                  dates={formatCVDate(e.date)}
                  url={e.doi ? `https://doi.org/${e.doi}` : e.url}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {awards.length > 0 && (
          <CVSection title="Honors &amp; Awards" id="awards">
            <ul class="folio-stack">
              {awards.map((e) => (
                <CVEntry
                  title={e.name ?? ''}
                  subtitle={e.issuer}
                  dates={formatCVDate(e.date)}
                  highlights={e.highlights}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {skills.length > 0 && (
          <CVSection title="Skills" id="skills">
            <dl class="cv-skills">
              {skills.map((e) => (
                <>
                  <dt>{e.label}</dt>
                  <dd>{e.details}</dd>
                </>
              ))}
            </dl>
          </CVSection>
        )}

        {interests.length > 0 && (
          <CVSection title="Interests" id="interests">
            <dl class="cv-skills">
              {interests.map((e) => (
                <>
                  <dt>{e.label}</dt>
                  <dd>{e.details}</dd>
                </>
              ))}
            </dl>
          </CVSection>
        )}
      </>
    )}

    <!-- ── JSONRESUME ─────────────────────────────────────────────── -->
    {format === 'jsonresume' && jr && (
      <>
        {jr.basics && (jr.basics.email || jr.basics.url) && (
          <section class="folio-row" id="contact">
            <p class="folio-label">Contact</p>
            <div class="folio-body">
              <dl class="cv-contact">
                {jrLabel && (
                  <>
                    <dt>Title</dt>
                    <dd>{jrLabel}</dd>
                  </>
                )}
                {jr.basics.email && (
                  <>
                    <dt>Email</dt>
                    <dd><a href={`mailto:${jr.basics.email}`}>{jr.basics.email}</a></dd>
                  </>
                )}
                {jr.basics.url && (
                  <>
                    <dt>Website</dt>
                    <dd>
                      <a href={jr.basics.url} target="_blank" rel="noopener noreferrer">
                        {jr.basics.url.replace(/^https?:\/\//, '')}
                      </a>
                    </dd>
                  </>
                )}
              </dl>
            </div>
          </section>
        )}

        {jr.work && jr.work.length > 0 && (
          <CVSection title="Experience" id="experience">
            <ul class="folio-stack">
              {jr.work.map((e) => (
                <CVEntry
                  title={e.position ?? ''}
                  subtitle={e.name}
                  url={e.url}
                  dates={formatDateRange(e.startDate, e.endDate)}
                  highlights={e.highlights}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {jr.education && jr.education.length > 0 && (
          <CVSection title="Education" id="education">
            <ul class="folio-stack">
              {jr.education.map((e) => (
                <CVEntry
                  title={[e.studyType, e.area].filter(Boolean).join(' in ')}
                  subtitle={e.institution}
                  url={e.url}
                  dates={formatDateRange(e.startDate, e.endDate)}
                  highlights={e.courses}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {jr.publications && jr.publications.length > 0 && (
          <CVSection title="Publications" id="publications">
            <ul class="folio-stack">
              {jr.publications.map((e) => (
                <CVEntry
                  title={e.name ?? ''}
                  subtitle={e.publisher}
                  url={e.url}
                  dates={formatCVDate(e.releaseDate)}
                  highlights={e.summary ? [e.summary] : []}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {jr.awards && jr.awards.length > 0 && (
          <CVSection title="Honors &amp; Awards" id="awards">
            <ul class="folio-stack">
              {jr.awards.map((e) => (
                <CVEntry
                  title={e.title ?? ''}
                  subtitle={e.awarder}
                  dates={formatCVDate(e.date)}
                  highlights={e.summary ? [e.summary] : []}
                />
              ))}
            </ul>
          </CVSection>
        )}

        {jr.skills && jr.skills.length > 0 && (
          <CVSection title="Skills" id="skills">
            <dl class="cv-skills">
              {jr.skills.map((e) => (
                <>
                  <dt>{e.name}</dt>
                  <dd>{e.keywords?.join(', ')}</dd>
                </>
              ))}
            </dl>
          </CVSection>
        )}

        {jr.languages && jr.languages.length > 0 && (
          <CVSection title="Languages" id="languages">
            <dl class="cv-skills">
              {jr.languages.map((e) => (
                <>
                  <dt>{e.language}</dt>
                  <dd>{e.fluency}</dd>
                </>
              ))}
            </dl>
          </CVSection>
        )}

        {jr.interests && jr.interests.length > 0 && (
          <CVSection title="Interests" id="interests">
            <dl class="cv-skills">
              {jr.interests.map((e) => (
                <>
                  <dt>{e.name}</dt>
                  <dd>{e.keywords?.join(', ')}</dd>
                </>
              ))}
            </dl>
          </CVSection>
        )}
      </>
    )}
  </div>
</Page>

<style>
  .folio-pagehead {
    padding-bottom: 1.5rem;
  }
  .folio-pagehead .post-title {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 2.9rem);
    letter-spacing: -0.02em;
  }
  .folio-pagehead .folio-more {
    margin-top: 0.85rem;
  }

  /* Contact + skills: mono key rail + sans value */
  .cv-contact,
  .cv-skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
  .cv-contact dt,
  .cv-skills dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--global-text-color-light);
    padding-top: 0.15rem;
  }
  .cv-contact dd,
  .cv-skills dd {
    margin: 0;
    color: var(--global-text-color);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .cv-contact dd a {
    color: var(--global-text-color);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--global-theme-color) 40%, transparent);
  }
  .cv-contact dd a:hover {
    border-color: var(--global-theme-color);
    color: var(--global-theme-color);
  }

  @media (max-width: 640px) {
    .cv-contact,
    .cv-skills {
      grid-template-columns: 1fr;
      gap: 0.15rem 0;
    }
    .cv-skills dd {
      margin-bottom: 0.75rem;
    }
  }
</style>
