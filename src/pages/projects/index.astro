---
import ProjectCard from '@components/projects/ProjectCard.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999),
);

// Collect unique categories preserving first-appearance order
const categories: string[] = [];
for (const p of projects) {
  if (p.data.category && !categories.includes(p.data.category)) {
    categories.push(p.data.category);
  }
}
// Projects with no category still need a home at the end of the page.
const uncategorised = projects.filter((p) => !p.data.category);
const hasCategories = categories.length > 0;
---

<Page title="Projects" description={`Projects by ${site.author.name}`}>
  <div class="folio">
    <header class="folio-pagehead">
      <h1 class="folio-pagetitle">Projects</h1>
      <p class="folio-pagedesc">{site.pages.projects.description}</p>
    </header>

    {
      projects.length === 0 ? (
        <section class="folio-row">
          <p class="folio-label">Projects</p>
          <div class="folio-body">
            <p class="folio-empty">No projects yet.</p>
          </div>
        </section>
      ) : hasCategories ? (
        <>
          {categories.map((cat) => (
            <section class="folio-row" id={cat}>
              <p class="folio-label">{cat}</p>
              <div class="folio-body">
                <ul class="folio-stack">
                  {projects
                    .filter((p) => p.data.category === cat)
                    .map((project) => (
                      <ProjectCard project={project} />
                    ))}
                </ul>
              </div>
            </section>
          ))}
          {uncategorised.length > 0 && (
            <section class="folio-row">
              <p class="folio-label">Other</p>
              <div class="folio-body">
                <ul class="folio-stack">
                  {uncategorised.map((project) => (
                    <ProjectCard project={project} />
                  ))}
                </ul>
              </div>
            </section>
          )}
        </>
      ) : (
        <section class="folio-row">
          <p class="folio-label">All</p>
          <div class="folio-body">
            <ul class="folio-stack">
              {projects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </div>
</Page>

<script>
  function initCards() {
    // Delegate row clicks to the project link, so inner <a>s still work
    // independently and we never nest anchors.
    document.querySelectorAll<HTMLElement>('.proj[data-href]').forEach((row) => {
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        const href = row.dataset.href;
        if (!href) return;
        if (row.dataset.external === 'true') {
          window.open(href, '_blank', 'noopener,noreferrer');
        } else {
          window.location.href = href;
        }
      });

      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          row.click();
        }
      });
    });
  }

  // Fetch GitHub star counts from the API
  async function loadGithubStars() {
    const spans = document.querySelectorAll<HTMLElement>('[data-github-stars]');
    await Promise.all(
      [...spans].map(async (span) => {
        const repo = span.dataset.githubStars;
        if (!repo) return;
        try {
          const res = await fetch(`https://api.github.com/repos/${repo}`, {
            headers: { Accept: 'application/vnd.github.v3+json' },
          });
          if (!res.ok) return;
          const data = (await res.json()) as { stargazers_count?: number };
          if (typeof data.stargazers_count === 'number') {
            span.textContent = data.stargazers_count.toLocaleString();
          }
        } catch {
          // Silently ignore — stars are decorative
        }
      }),
    );
  }

  document.addEventListener('astro:page-load', () => {
    initCards();
    loadGithubStars();
  });
</script>
