---
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', (p) => !p.data.hidden && !p.data.draft);

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Page title="Tags" description={`All post tags on ${site.author.name}'s blog`}>
  <div class="folio">
    <header class="folio-pagehead">
      <div class="folio-actions back">
        <a class="folio-action" href={`${site.base}/blog/`}>All posts</a>
      </div>
      <h1 class="folio-pagetitle">Tags</h1>
      <p class="folio-pagedesc">Every tag used across the blog, with post counts.</p>
    </header>

    <section class="folio-row">
      <p class="folio-label">Index</p>
      <div class="folio-body">
        {
          tags.length === 0 ? (
            <p class="folio-empty">No tags yet.</p>
          ) : (
            <ul class="folio-stack">
              {tags.map(([tag, count]) => (
                <li class="folio-entry">
                  <div class="folio-entry-head">
                    <a class="folio-entry-title" href={`${site.base}/blog/tag/${tag}/`}>
                      #{tag}
                    </a>
                    <span class="folio-date">
                      {count} post{count !== 1 ? 's' : ''}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </div>
</Page>

<style>
  .back {
    margin-bottom: 1.1rem;
  }
</style>
