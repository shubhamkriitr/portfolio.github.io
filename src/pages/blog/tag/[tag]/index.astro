---
import BlogListing from '@components/blog/BlogListing.astro';
import { site } from '@config/site';
import Page from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const perPage = site.blog.postsPerPage;
  const postTags = allPosts.flatMap((p) => p.data.tags);
  const allTags = [...new Set([...postTags, ...site.blog.displayTags])];

  return allTags.map((tag) => {
    const tagPosts = allPosts
      .filter((p) => !p.data.hidden && !p.data.draft && p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = Math.max(1, Math.ceil(tagPosts.length / perPage));
    return {
      params: { tag },
      props: {
        posts: tagPosts.slice(0, perPage),
        currentPage: 1,
        totalPages,
      },
    };
  });
}

const { tag } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<Page title={`Tag: ${tag}`} description={`Posts tagged "${tag}"`}>
  <BlogListing
    title={`#${tag}`}
    description={`Posts tagged "${tag}".`}
    posts={posts}
    backLinks={[
      { label: 'All posts', href: `${base}/blog/` },
      { label: 'Tag cloud', href: `${base}/blog/tags/` },
    ]}
    groupByYear={false}
    listLabel="Tagged"
    emptyMessage="No posts found for this tag."
    currentPage={currentPage}
    totalPages={totalPages}
    nextUrl={totalPages > 1 ? `${base}/blog/tag/${tag}/page/2/` : undefined}
    basePath={`${base}/blog/tag/${tag}/`}
  />
</Page>
