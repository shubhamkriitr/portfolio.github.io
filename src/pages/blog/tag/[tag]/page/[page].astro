---
import BlogListing from '@components/blog/BlogListing.astro';
import { site } from '@config/site';
import PageLayout from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const perPage = site.blog.postsPerPage;
  const postTags = allPosts.flatMap((p) => p.data.tags);
  const allTags = [...new Set([...postTags, ...site.blog.displayTags])];

  return allTags.flatMap((tag) => {
    const tagPosts = allPosts
      .filter((p) => !p.data.hidden && !p.data.draft && p.data.tags.includes(tag))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = Math.ceil(tagPosts.length / perPage);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
      const page = i + 2;
      return {
        params: { tag, page: String(page) },
        props: {
          posts: tagPosts.slice((page - 1) * perPage, page * perPage),
          currentPage: page,
          totalPages,
        },
      };
    });
  });
}

const { tag } = Astro.params;
const { posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<PageLayout
  title={`Tag: ${tag} — Page ${currentPage}`}
  description={`Posts tagged "${tag}", page ${currentPage}`}
>
  <BlogListing
    title={`#${tag}`}
    description={`Posts tagged "${tag}".`}
    posts={posts}
    backLinks={[
      { label: 'All posts', href: `${base}/blog/` },
      { label: 'Tag cloud', href: `${base}/blog/tags/` },
    ]}
    groupByYear={false}
    listLabel="Tagged"
    emptyMessage="No posts found for this tag."
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={currentPage === 2
      ? `${base}/blog/tag/${tag}/`
      : `${base}/blog/tag/${tag}/page/${currentPage - 1}/`}
    nextUrl={currentPage < totalPages
      ? `${base}/blog/tag/${tag}/page/${currentPage + 1}/`
      : undefined}
    basePath={`${base}/blog/tag/${tag}/`}
  />
</PageLayout>
