---
import BlogListing from '@components/blog/BlogListing.astro';
import { site } from '@config/site';
import PageLayout from '@layouts/Page.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', (p) => !p.data.hidden && !p.data.draft);
  const perPage = site.blog.postsPerPage;
  const years = [...new Set(allPosts.map((p) => p.data.date.getFullYear()))];

  return years.flatMap((year) => {
    const yearPosts = allPosts
      .filter((p) => p.data.date.getFullYear() === year)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const totalPages = Math.ceil(yearPosts.length / perPage);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
      const page = i + 2;
      return {
        params: { year: String(year), page: String(page) },
        props: {
          year,
          posts: yearPosts.slice((page - 1) * perPage, page * perPage),
          currentPage: page,
          totalPages,
        },
      };
    });
  });
}

const { year, posts, currentPage, totalPages } = Astro.props;
const base = site.base;
---

<PageLayout
  title={`Blog — ${year} — Page ${currentPage}`}
  description={`Posts from ${year}, page ${currentPage}`}
>
  <BlogListing
    title={String(year)}
    description={`All posts from ${year}.`}
    posts={posts}
    backLinks={[{ label: 'All posts', href: `${base}/blog/` }]}
    groupByYear={false}
    listLabel={String(year)}
    emptyMessage={`No posts from ${year}.`}
    currentPage={currentPage}
    totalPages={totalPages}
    prevUrl={currentPage === 2
      ? `${base}/blog/year/${year}/`
      : `${base}/blog/year/${year}/page/${currentPage - 1}/`}
    nextUrl={currentPage < totalPages
      ? `${base}/blog/year/${year}/page/${currentPage + 1}/`
      : undefined}
    basePath={`${base}/blog/year/${year}/`}
  />
</PageLayout>
