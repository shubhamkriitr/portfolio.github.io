---
import SocialLinks from '@components/SocialLinks.astro';
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { withBase } from '@utils/base';
import { getAuthors, getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import type { RenderCV, RenderCVEntry } from '@utils/cv';
import { formatDateRange } from '@utils/cv';
import { getCollection } from 'astro:content';
import yaml from 'js-yaml';

import AboutContent from '../data/about.mdx';
import cvRaw from '../data/cv.yml?raw';
import bibRaw from '../data/papers.bib?raw';

// Featured projects — top entries by importance (lower = shown first)
const featuredProjects = (await getCollection('projects'))
  .sort((a, b) => (a.data.importance ?? 999) - (b.data.importance ?? 999))
  .slice(0, 3);

// Selected publications
const selectedPapers = site.selectedPapers.enabled
  ? parseBibtex(bibRaw).filter((e) => getBoolField(e, 'selected'))
  : [];

// Recent experience (top 4 from the CV)
const rc = (yaml.load(cvRaw) as RenderCV)?.cv ?? null;
const experience = ((rc?.sections?.experience ?? []) as RenderCVEntry[]).slice(0, 4);

const avatar = withBase(site.author.avatar);
const avatarFallback = withBase('/assets/img/prof_pic.jpg');
---

<Base isHome={true}>
  <div class="folio">
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <header class="folio-hero">
      <div class="folio-hero-main">
        {site.author.moreInfo && (
          <p class="folio-eyebrow"><span class="dot" set:html={site.author.moreInfo} /></p>
        )}
        <h1 class="post-title folio-name">
          {(site.title as string) === 'blank' ? site.author.name : site.title}
        </h1>
        {site.author.subtitle && <p class="folio-role" set:html={site.author.subtitle} />}
        <div class="folio-links">
          <SocialLinks size={17} />
        </div>
      </div>
      <div class="folio-photo">
        <img
          src={avatar}
          alt={site.author.name}
          width="128"
          height="128"
          loading="eager"
          fetchpriority="high"
          onerror={`this.src='${avatarFallback}'`}
        />
      </div>
    </header>

    <!-- ── About ────────────────────────────────────────────── -->
    <section class="folio-row" id="about">
      <p class="folio-label">About</p>
      <div class="folio-body folio-prose">
        <AboutContent />
      </div>
    </section>

    <!-- ── Experience ───────────────────────────────────────── -->
    {experience.length > 0 && (
      <section class="folio-row" id="experience">
        <p class="folio-label">Experience</p>
        <div class="folio-body">
          <ul class="folio-stack">
            {experience.map((e) => (
              <li class="folio-entry">
                <div class="folio-entry-head">
                  <span class="folio-entry-title">{e.position}</span>
                  <span class="folio-date">{formatDateRange(e.start_date, e.end_date)}</span>
                </div>
                <span class="folio-entry-sub">{e.company}</span>
              </li>
            ))}
          </ul>
          <a class="folio-more" href={`${site.base}/cv/`}>Full CV &rarr;</a>
        </div>
      </section>
    )}

    <!-- ── Selected work ────────────────────────────────────── -->
    {featuredProjects.length > 0 && (
      <section class="folio-row" id="work">
        <p class="folio-label">Selected&nbsp;Work</p>
        <div class="folio-body">
          <ul class="folio-stack">
            {featuredProjects.map((project, i) => (
              <li>
                <a class="folio-worklink" href={`${site.base}/projects/${project.id}/`}>
                  <span class="folio-idx">{String(i + 1).padStart(2, '0')}</span>
                  <span>
                    <span class="folio-work-title">
                      {project.data.title}
                      {project.data.category && <span class="folio-tag">{project.data.category}</span>}
                    </span>
                    {project.data.description && (
                      <span class="folio-work-desc">{project.data.description}</span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a class="folio-more" href={`${site.base}/projects/`}>All projects &rarr;</a>
        </div>
      </section>
    )}

    <!-- ── Publications ─────────────────────────────────────── -->
    {site.selectedPapers.enabled && selectedPapers.length > 0 && (
      <section class="folio-row" id="publications">
        <p class="folio-label">Publications</p>
        <div class="folio-body">
          <ul class="folio-stack">
            {selectedPapers.map((entry) => {
              const title = getTitle(entry);
              const url =
                entry.fields.html ??
                (entry.fields.doi ? `https://doi.org/${entry.fields.doi}` : '');
              const venue = getVenue(entry);
              const year = getYear(entry);
              return (
                <li class="folio-entry">
                  {url ? (
                    <a class="folio-entry-title" href={url} target="_blank" rel="noopener noreferrer">
                      {title}
                    </a>
                  ) : (
                    <span class="folio-entry-title">{title}</span>
                  )}
                  <span class="folio-entry-meta">
                    {getAuthors(entry)}
                    {(venue || year) && <span> · {venue}{venue && year ? ', ' : ''}{year}</span>}
                  </span>
                </li>
              );
            })}
          </ul>
          <a class="folio-more" href={`${site.base}/publications/`}>All publications &rarr;</a>
        </div>
      </section>
    )}
  </div>
</Base>
